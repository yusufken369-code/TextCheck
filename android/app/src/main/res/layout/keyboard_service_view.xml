<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#122B49"
    android:animateLayoutChanges="true"
    android:paddingBottom="8dp">

    <!-- Legal Warning Horizontal Scrollable Strip -->
    <LinearLayout
        android:id="@+id/warningCardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFF0F0"
        android:animateLayoutChanges="true"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="6dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone">

        <!-- Fixed Left Warning Badge -->
        <TextView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:text="!"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            android:gravity="center"
            android:background="#DC2626"
            android:layout_marginRight="8dp" />

        <!-- Horizontal Scrollable Cards View -->
        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Card 1: Warning Title Badge -->
                <TextView
                    android:id="@+id/warningTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Huquqiy ogohlantirish"
                    android:textColor="#DC2626"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="#FEE2E2"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_marginRight="6dp" />

                <!-- Card 2: Warning Message Text -->
                <TextView
                    android:id="@+id/warningDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ushbu matn haqoratga oid huquqiy normalarga aloqador bo‘lishi mumkin."
                    android:textColor="#991B1B"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:background="#FEF2F2"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_marginRight="6dp" />

                <!-- Card 3: Relevant Legal Article Link -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#FEE2E2"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_marginRight="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚖️ Tegishli modda: "
                        android:textColor="#7F1D1D"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/warningDocTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ma’muriy javobgarlik to‘g‘risidagi kodeks (Modda 183)"
                        android:textColor="#DC2626"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Card 4: Legal Penalty / Consequence Info -->
                <TextView
                    android:id="@+id/warningPenalty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ Oqibat: BHM 2-5 baravarigacha jarima"
                    android:textColor="#B91C1C"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:background="#FEF2F2"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Fixed Right Dismiss Button -->
        <TextView
            android:id="@+id/closeWarningBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textColor="#991B1B"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingLeft="8dp"
            android:paddingRight="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

    </LinearLayout>

    <!-- Top Toolbar of System Keyboard -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/langUz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Ўз"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp"
            android:background="#1E3653"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginRight="4dp" />

        <TextView
            android:id="@+id/langRu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Рус"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginRight="4dp" />

        <TextView
            android:id="@+id/langEng"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Eng"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/toggleLegalCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️ Yoqilgan"
            android:textColor="#10B981"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:background="#064E3B"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginRight="6dp" />

        <TextView
            android:id="@+id/hideKeyboardBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▼"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <!-- Keyboard Rows Container -->
    <LinearLayout
        android:id="@+id/keyboardKeysLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="4dp"
        android:paddingRight="4dp" />

</LinearLayout>
